{
  "name": "css-components",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "title": "Pure CSS Components",
  "description": "A set of common UI Components using the power of CSS and without JavaScript",
  "homepage": "https://css-components.felipefialho.com",
  "author": {
    "name": "Felipe Fialho",
    "email": "hi@felipefialho.com",
    "url": "https://www.felipefialho.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,astro}\" --fix"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
